ARG RUNTIME_BASE=mcr.microsoft.com/dotnet/runtime-deps:10.0-noble

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

RUN apt-get update \
    && apt-get install -y --no-install-recommends clang zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

COPY . .

RUN dotnet publish src/Rinha2026.LoadBalancer/Rinha2026.LoadBalancer.csproj \
    -c Release \
    -r linux-x64 \
    -o /out/lb \
    --self-contained true \
    -p:PublishAot=true \
    -p:StripSymbols=true

FROM ${RUNTIME_BASE} AS runtime
WORKDIR /app

ENV ASPNETCORE_URLS=http://+:9999
ENV BACKEND_ENDPOINTS=api1:9999;api2:9999
ENV BACKEND_POOL_SIZE=32
ENV BACKEND_PREWARM_CONNECTIONS=16
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1

COPY --from=build /out/lb ./

EXPOSE 9999

ENTRYPOINT ["./Rinha2026.LoadBalancer"]
